LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=slack-to-pr
LANGSMITH_API_KEY=<EU workspace API key>
# Workspace UUID from Settings > Workspaces.
LANGSMITH_WORKSPACE_ID=<workspace UUID>

OPENAI_API_KEY=<OpenAI API key>
PR_AGENT_MODEL=gpt-6-astra

SLACK_TEAM_ID=<workspace ID starting with T>
SLACK_SIGNING_SECRET=<Slack app signing secret>
SLACK_BOT_TOKEN=<xoxb bot token>
# Only this verified Slack account may approve, revoke or merge task PRs.
FLAKEY_APPROVER_SLACK_ID=U0C4RUL6CMQ
# Optional separate history token if your workspace requires user authorization.
# SLACK_HISTORY_TOKEN=<user token with channel history scope>

# Fine-grained token restricted to vasvalstan/flakeyflakey.
# Repository permissions: Contents read/write, Pull requests read/write, Metadata read,
# Administration read (inspect protected-branch settings; never Administration write).
FLAKEY_GITHUB_TOKEN=<fine-grained GitHub token>
# Receiver only: fine-grained token with Contents read/write, Metadata read.
# GitHub repository_dispatch requires Contents write, not Actions write.
FLAKEY_DISPATCH_TOKEN=<GitHub repository dispatch token>
# Shared by receiver and Actions. Generate with: openssl rand -hex 32
FLAKEY_STATE_KEY=<64 hex characters>
# Local receiver defaults. Railway sets PORT and uses HOST=0.0.0.0.
HOST=127.0.0.1
PORT=8787
GREPTILE_BOT_LOGINS=greptile-apps[bot],greptile[bot],greptileai[bot]
FLAKEY_SANDBOX_SNAPSHOT=flakey-pr-agent-v1
